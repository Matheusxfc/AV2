# ---- Servidor ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Origens permitidas no CORS, separadas por virgula. "*" libera tudo (apenas desenvolvimento).
CORS_ORIGIN=*

# ---- Banco de dados (PostgreSQL) ----
# Combina com o docker-compose.yml deste projeto.
DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode?schema=public"

# ---- Autenticacao ----
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN=30m
BCRYPT_ROUNDS=10

# ---- Seed (apenas desenvolvimento) ----
ADMIN_USUARIO=admin
ADMIN_SENHA=Admin@12345
LOGIN_RATE_LIMIT_MAX=20
